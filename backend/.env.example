# Copy this file to .env for local development, or set these as
# environment variables in your hosting platform (Render, etc).
# Never commit an actual .env file — it's already in .gitignore.

# --- Required for a real deployment ---

# Signs session cookies. If unset, the app still runs but generates a
# random secret per process, meaning every restart/redeploy logs
# everyone out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# MongoDB connection string (Atlas or self-hosted).
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=edupredict

# Comma-separated list of every frontend URL allowed to call this API
# (Vercel gives a project more than one valid URL — production alias,
# git-branch alias, custom domain, etc — list all of them you use).
FRONTEND_ORIGIN=http://localhost:5173

# Required to create the first admin account (see docs/DEPLOYMENT.md).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_SETUP_KEY=

# --- Optional ---

# SMTP email (high-risk alerts, password reset links). If unset, the
# app logs to console and skips sending instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set by the hosting platform automatically — only needed for local dev.
PORT=5000
FLASK_DEBUG=false
